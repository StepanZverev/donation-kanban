# Скопируй этот файл в .env и впиши ключи приложения DonationAlerts
# (https://www.donationalerts.com/application/clients). Файл .env в git не попадает.
DA_CLIENT_ID=
DA_CLIENT_SECRET=

# Должен совпадать с Redirect URL, указанным при регистрации приложения
DA_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Адрес сайта: сюда вернётся браузер после входа в DonationAlerts.
# Если адрес начинается с https://, бэкенд считает, что работает на настоящем сервере:
# cookie входа уходят только по HTTPS, а тестовые донаты выключены
FRONTEND_URL=http://127.0.0.1:5173

# Адрес базы PostgreSQL. Если запускаешь базу через docker-compose.yml, оставь как есть
# (это же значение используется по умолчанию, если строки нет)
DATABASE_URL=postgresql://donation_kanban:donation_kanban@localhost:5432/donation_kanban
