# Скопируй в deploy/.env на сервере и заполни. Файл .env в git не попадает.

# Домен сайта без https://, например donation-kanban.ru
DOMAIN=

# Пароль базы данных: любая длинная случайная строка.
# Придумать можно командой: openssl rand -hex 24
POSTGRES_PASSWORD=

# Ключи приложения DonationAlerts (https://www.donationalerts.com/application/clients).
# В приложении DA добавь Redirect URL: https://<домен>/api/auth/callback
DA_CLIENT_ID=
DA_CLIENT_SECRET=

# Ключ, которым шифруются токены DonationAlerts в базе. Придумать командой:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Сохрани копию ключа в надёжном месте (менеджер паролей): в бэкапах базы его нет.
# Если ключ потерять, стримерам придётся заново войти через DonationAlerts — доски не пострадают.
TOKEN_ENCRYPTION_KEY=
